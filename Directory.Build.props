<Project>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!--
      恒久的に無効化:
        CA1848 (LoggerMessage delegates) — LoggerMessage 生成器は導入しない方針
        CA5350/CA5351 (weak/broken crypto: HMACSHA1/MD5) — STUN/TURN 仕様要件
        CA1711 (type name ends with reserved suffix) — StunAttribute / CreatePermission は仕様用語
    -->
    <NoWarn>$(NoWarn);CA1848;CA5350;CA5351;CA1711</NoWarn>
  </PropertyGroup>

</Project>
